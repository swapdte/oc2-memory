#!/usr/bin/env bash
set -euo pipefail

if [ ! -d node_modules ]; then
	echo "pre-commit: dependencies are not installed — run 'npm install'." >&2
	exit 1
fi

echo "Running lint..."
npm run lint

echo "Typechecking..."
npm run build

