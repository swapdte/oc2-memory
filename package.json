{
	"name": "oc2-memory",
	"version": "0.1.0",
	"description": "OpenCode V2 plugin that gives the coding agent a memory: durable facts, a daily log and a scratchpad as plain markdown, with optional qmd-powered search. A port of pi-memory.",
	"type": "module",
	"main": "./dist/index.js",
	"exports": {
		".": "./dist/index.js",
		"./server": "./dist/index.js"
	},
	"license": "MIT",
	"author": "swapdte",
	"contributors": [
		"Jay Zeng (pi-memory upstream)"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/swapdte/oc2-memory.git"
	},
	"bugs": {
		"url": "https://github.com/swapdte/oc2-memory/issues"
	},
	"homepage": "https://github.com/swapdte/oc2-memory#readme",
	"keywords": [
		"opencode",
		"opencode-plugin",
		"memory",
		"markdown",
		"qmd",
		"scratchpad",
		"daily-log"
	],
	"files": [
		"dist",
		"scripts",
		"README.md",
		"CHANGELOG.md",
		"LICENSE"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsup index.ts --format esm --dts && tsc -p tsconfig.json --noEmit",
		"lint": "biome check .",
		"test": "bun test test/unit.test.ts",
		"test:e2e": "npx tsx test/e2e.ts",
		"test:eval": "bun test/eval-recall.ts",
		"postinstall": "node scripts/postinstall.cjs"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.0",
		"@opencode/plugin": "2.0.2",
		"tsup": "^8.5.0",
		"tsx": "^4.0.0",
		"typescript": "^5.9.3"
	},
	"peerDependencies": {},
	"engines": {
		"node": ">=22.19.0"
	},
	"overrides": {
		"rimraf": "^6.1.3",
		"glob": "^13.0.3"
	}
}
